import os

# Compile the analysis scripts
rule dvcs_compile:
    input:
        ROOT_BUILD_DIR_PREFIX + "benchmarks/Exclusive-Diffraction-Tagging/dvcs/analysis/dvcs_tests_cxx.so",

# Simulation rule
rule dvcs_sim:
    input:
        warmup="warmup/{DETECTOR_CONFIG}.edm4hep.root",
        geometry_lib=find_epic_libraries(),
    output:
        "sim/{DETECTOR_CONFIG}/dvcs.edm4hep.root",
    params:
        N_EVENTS=os.getenv("JUGGLER_N_EVENTS", 100),
        DD4HEP_HASH=get_spack_package_hash("dd4hep"),
        NPSIM_HASH=get_spack_package_hash("npsim"),
        INPUT_FILE="root://dtn-eic.jlab.org//volatile/eic/EPIC/EVGEN/EXCLUSIVE/DVCS_ABCONV/10x100/DVCS.1.ab.hiDiv.10x100.hepmc3.tree.root",
    cache: True
    shell:
        """
npsim \
  --runType batch \
  --part.minimalKineticEnergy 1000*GeV  \
  --filter.tracker edep0 \
  -v ERROR \
  --numberOfEvents {params.N_EVENTS} \
  --compactFile $DETECTOR_PATH/{wildcards.DETECTOR_CONFIG}.xml \
  --inputFiles {params.INPUT_FILE} \
  --outputFile {output}
"""

# Reconstruction rule
rule dvcs_reco:
    input:
        "sim/{DETECTOR_CONFIG}/dvcs.edm4hep.root",
    output:
        "reco/{DETECTOR_CONFIG}/dvcs.edm4eic.root",
    params:
        EICRECON_HASH=get_spack_package_hash("eicrecon"),
    cache: True
    shell:
        """
DETECTOR_CONFIG={wildcards.DETECTOR_CONFIG} eicrecon {input} -Ppodio:output_file={output}
"""

# Analysis rule
rule dvcs_analysis:
    input:
        script="benchmarks/Exclusive-Diffraction-Tagging/dvcs/analysis/dvcs_tests.cxx",
        script_compiled=ROOT_BUILD_DIR_PREFIX + "benchmarks/Exclusive-Diffraction-Tagging/dvcs/analysis/dvcs_tests_cxx.so",
        data="reco/{DETECTOR_CONFIG}/dvcs.edm4eic.root",
    output:
        "results/{DETECTOR_CONFIG}/dvcs/dvcs_analysis_done.txt",
    shell:
        """
mkdir -p results/{wildcards.DETECTOR_CONFIG}/dvcs
cd results/{wildcards.DETECTOR_CONFIG}/dvcs
root -l -b -q '{input.script}+("../../../{input.data}")'
touch ../../../{output}
"""

# Top-level rule to run everything
rule dvcs_run_locally:
    input:
        "results/" + os.environ["DETECTOR_CONFIG"] + "/dvcs/dvcs_analysis_done.txt",
    message:
        "DVCS benchmark complete. See output in results/{DETECTOR_CONFIG}/dvcs/"
